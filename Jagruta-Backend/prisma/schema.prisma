generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Constituency {
  id           String       @id @default(cuid())
  name         String
  pincode      String       @unique
  district     String?
  state        String       @default("Karnataka")

  politicians  Politician[]
  reportCard   ReportCard?

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Politician {
  id              String        @id @default(cuid())
  name            String
  party           String
  level           String        @default("MLA")

  constituencyId  String
  constituencyRef Constituency  @relation(fields: [constituencyId], references: [id])

  score           Float         @default(70)
  attendance      Float         @default(75)
  yearsInOffice   Int           @default(1)
  criminalCases   Int           @default(0)

  imageUrl        String?
  lat             Float?
  lng             Float?

  criminalRecords Json?
  assetHistory    Json?
  questionsAsked  Json?

  aiSummary       String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Manifesto {
  id          String   @id @default(cuid())
  party       String
  category    String
  title       String
  description String
  status      String
  progress    Int      @default(0)
  evidence    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ReportCard {
  id             String       @id @default(cuid())
  constituencyId String       @unique

  grade          String
  overallScore   Float

  sections       Json

  constituency   Constituency @relation(fields: [constituencyId], references: [id])

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}